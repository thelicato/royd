<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.royd.networkcontrol">
    <uses-sdk android:minSdkVersion="35" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application android:label="royd network control" android:testOnly="true" android:usesCleartextTraffic="true">
        <activity android:name="org.royd.networkprobe.NetworkProbe" android:exported="true" />
        <activity android:name="org.royd.networkprobe.MeteredProbeLauncher" android:exported="true" android:turnScreenOn="true" android:showWhenLocked="true" />
        <service android:name="org.royd.networkprobe.MeteredProbeService" android:exported="false" />
    </application>
</manifest>

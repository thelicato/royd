#!/system/bin/sh
set -eu

release_file=${ROYD_RELEASE_FILE:-/royd-release}
runtime_file=${ROYD_RUNTIME_CONFIG:-/royd-runtime.conf}

hal_profile=graphical
if [ -r "$release_file" ]; then
  # royd-release is generated by this repository and contains only KEY=value metadata.
  # shellcheck disable=SC1090
  . "$release_file"
  hal_profile=${ROYD_HAL_PROFILE:-graphical}
fi

case "$hal_profile" in
  graphical)
    width=540
    height=960
    dpi=240
    fps=30
    ;;
  headless)
    width=64
    height=64
    dpi=72
    fps=5
    ;;
  *)
    printf 'royd: unsupported HAL profile in release metadata: %s\n' "$hal_profile" >&2
    exit 64
    ;;
esac

positive_integer() {
  name=$1
  value=$2
  case "$value" in
    ''|*[!0-9]*|0)
      printf 'royd: %s must be a positive integer, got %s\n' "$name" "$value" >&2
      exit 64
      ;;
  esac
}

for argument in "$@"; do
  case "$argument" in
    royd.width=*) width=${argument#royd.width=} ;;
    royd.height=*) height=${argument#royd.height=} ;;
    royd.dpi=*) dpi=${argument#royd.dpi=} ;;
    royd.fps=*) fps=${argument#royd.fps=} ;;
    '') ;;
    *)
      printf 'royd: unknown runtime argument: %s\n' "$argument" >&2
      exit 64
      ;;
  esac
done

positive_integer width "$width"
positive_integer height "$height"
positive_integer dpi "$dpi"
positive_integer fps "$fps"

umask 077
printf 'ROYD_WIDTH=%s\nROYD_HEIGHT=%s\nROYD_DPI=%s\nROYD_FPS=%s\n' \
  "$width" "$height" "$dpi" "$fps" > "$runtime_file"

if [ "${ROYD_ENTRYPOINT_TEST_ONLY:-0}" = 1 ]; then
  exit 0
fi

exec /init

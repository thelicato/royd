# Copy this file to runtime/.env to override local Compose defaults.
ROYD_IMAGE=royd:dev
ROYD_CONTAINER=royd
ROYD_DATA_VOLUME=royd-data
ROYD_ADB_BIND=127.0.0.1
ROYD_ADB_PORT=5555
# Android 15: required uses stock key authentication. See docs/adb.md for key mounts.
ROYD_ADB_AUTH=disabled
ROYD_WIDTH=540
ROYD_HEIGHT=960
ROYD_DPI=240
ROYD_FPS=30
# Supported values: low-memory, performance. Performance currently requires Android 15.
ROYD_RESOURCE_PROFILE=low-memory
# Supported values: privileged, experimental
ROYD_SECURITY_MODE=privileged
# Supported values: software, host-gpu-generic, host-gpu-intel
ROYD_GRAPHICS_BACKEND=software

# Copy this file to runtime/.env to override local Compose defaults.
ROYD_IMAGE=royd:dev
ROYD_CONTAINER=royd
ROYD_DATA_VOLUME=royd-data
ROYD_ADB_BIND=127.0.0.1
ROYD_ADB_PORT=5555
ROYD_WIDTH=540
ROYD_HEIGHT=960
ROYD_DPI=240
ROYD_FPS=30
# Supported values: privileged, experimental
ROYD_SECURITY_MODE=privileged
# Supported values: software, host-gpu-generic, host-gpu-intel
ROYD_GRAPHICS_BACKEND=software

# Experimental deterministic reduced-privilege runtime profile.
# The first fourteen entries reproduce Docker's documented default kept set.
# The final five are royd-specific elevated candidates that still require real-host reduction testing.
ROYD_SECURITY_PROFILE_FORMAT=1
ROYD_SECURITY_PROFILE_ID='experimental-v2-exact-caps'
ROYD_SECURITY_PRIVILEGED=0
ROYD_CAP_DROP_ALL=1
ROYD_CAPABILITIES='AUDIT_WRITE CHOWN DAC_OVERRIDE FOWNER FSETID KILL MKNOD NET_BIND_SERVICE NET_RAW SETFCAP SETGID SETPCAP SETUID SYS_CHROOT SYS_ADMIN NET_ADMIN SYS_NICE SYS_RESOURCE SYS_PTRACE'

on early-init
    setprop service.adb.tcp.port 5555
    exec -- /vendor/bin/royd-binder-setup
    exec -- /vendor/bin/royd-display-bootstrap
    exec -- /vendor/bin/royd-hardware-setup
    exec -- /vendor/bin/royd-graphics-setup

service royd-logcat /vendor/bin/royd-logcat
    class core
    user root
    group root log
    disabled

on property:init.svc.logd=running
    start royd-logcat

on post-fs-data
    setprop service.adb.tcp.port 5555
    start adbd

# OCI supplies the mounted Android partitions, so there is no device fstab or
# mount_all result to queue this event as it would on a conventional device.
on late-fs
    trigger nonencrypted

service royd-boot-watchdog /vendor/bin/royd-boot-watchdog
    class core
    user root
    group root log
    disabled
    oneshot

on property:init.svc.zygote=running
    start royd-boot-watchdog

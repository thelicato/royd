on early-init
    setprop service.adb.tcp.port 5555
    exec -- /vendor/bin/royd-binder-setup
    exec -- /vendor/bin/royd-display-bootstrap
    exec -- /vendor/bin/royd-hardware-setup
    exec -- /vendor/bin/royd-graphics-setup

service royd-logcat /vendor/bin/royd-logcat
    class core
    user root
    group root log
    disabled

on property:init.svc.logd=running
    start royd-logcat

on post-fs-data
    setprop service.adb.tcp.port 5555
    start adbd

# Stock Android resets this property to false during post-fs-data. The later
# vendor action selects libcutils' sealed-memfd path on the validated release.
on post-fs-data && property:ro.build.version.sdk=35
    setprop sys.use_memfd true

# OCI supplies the mounted Android partitions, so there is no device fstab or
# mount_all result to queue this event as it would on a conventional device.
on late-fs
    trigger nonencrypted

# Android policy routing ends with an unreachable rule and does not know about
# the OCI-provided eth0 network. Keep its earlier selections authoritative, then
# fall back to the kernel main table for fresh inbound connection replies.
on property:sys.boot_completed=1 && property:ro.build.version.sdk=35
    exec -- /system/bin/ip rule add pref 31999 lookup main

service royd-boot-watchdog /vendor/bin/royd-boot-watchdog
    class core
    user root
    group root log
    disabled
    oneshot

on property:init.svc.zygote=running
    start royd-boot-watchdog

cc_binary {
    name: "royd-binder-alloc",
    srcs: ["binder_alloc/royd-binder-alloc.c"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    vendor: true,
}

cc_binary {
    name: "royd-binder-info",
    srcs: ["binder_info/royd-binder-info.c"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    vendor: true,
}

cc_binary {
    name: "royd-memfd-probe",
    srcs: ["memfd_probe/royd-memfd-probe.c"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    vendor: true,
}

cc_library_shared {
    name: "gralloc.royd",
    srcs: ["gralloc/gralloc_royd.cpp"],
    relative_install_path: "hw",
    vendor: true,
    shared_libs: [
        "libcutils",
        "libhardware",
        "liblog",
    ],
    header_libs: ["libhardware_headers"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

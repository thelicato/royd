#!/system/bin/sh

stdout=/proc/1/fd/1
stderr=/proc/1/fd/2
binderfs=/dev/binderfs
control=$binderfs/binder-control

log() {
  printf '[royd] %s\n' "$*" > "$stdout"
}

fail() {
  printf '[royd] fatal: %s\n' "$*" > "$stderr"
  exit 1
}

log "kernel: $(uname -r)"
mkdir -p "$binderfs" || fail "cannot create $binderfs"

if [ ! -c "$control" ]; then
  log 'binderfs: mounting private instance'
  mount -t binder binder "$binderfs" || fail 'cannot mount binderfs; the host kernel must provide Android Binder IPC and binderfs'
fi
[ -c "$control" ] || fail "$control is unavailable after mounting binderfs"

missing=
for name in binder hwbinder vndbinder; do
  [ -c "$binderfs/$name" ] || missing="$missing $name"
done
if [ -n "$missing" ]; then
  # shellcheck disable=SC2086
  /vendor/bin/royd-binder-alloc "$control" $missing || fail 'cannot allocate Binder devices from binderfs'
fi

for name in binder hwbinder vndbinder; do
  target=$binderfs/$name
  path=/dev/$name
  [ -c "$target" ] || fail "$target is not a character device"
  if [ -L "$path" ] && [ "$(readlink "$path")" = "$target" ]; then
    continue
  fi
  rm -f "$path" || fail "cannot replace $path with the private binderfs device"
  ln -s "$target" "$path" || fail "cannot expose $target at $path"
done

if [ -f /sys/fs/cgroup/cgroup.controllers ]; then
  log 'cgroup: v2'
else
  log 'cgroup: legacy or unavailable'
fi
render_node=
for node in /dev/dri/renderD*; do
  if [ -e "$node" ]; then
    render_node=$node
    break
  fi
done
if [ -n "$render_node" ]; then
  log "graphics: host render device detected at $render_node"
else
  log 'graphics: no host render device detected'
fi
log 'binderfs: ready'

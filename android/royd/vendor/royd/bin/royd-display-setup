#!/system/bin/sh

width=$(getprop ro.boot.royd_width)
height=$(getprop ro.boot.royd_height)
dpi=$(getprop ro.boot.royd_dpi)
fps=$(getprop ro.boot.royd_fps)

case "$width:$height" in
  *[!0-9:]*|:*|*:)
    ;;
  *)
    wm size "${width}x${height}" || true
    ;;
esac
case "$dpi" in
  ''|*[!0-9]*) ;;
  *) wm density "$dpi" || true ;;
esac
case "$fps" in
  ''|*[!0-9]*) ;;
  *)
    settings put system peak_refresh_rate "$fps" || true
    settings put system min_refresh_rate "$fps" || true
    ;;
esac

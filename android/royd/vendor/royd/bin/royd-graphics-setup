#!/system/bin/sh

stdout=/proc/1/fd/1
stderr=/proc/1/fd/2

log() {
  printf '[royd] %s\n' "$*" > "$stdout"
}

warn() {
  printf '[royd] warning: %s\n' "$*" > "$stderr"
}

allocator=$(getprop ro.vendor.royd.graphics_allocator)
composer=$(getprop ro.vendor.royd.graphics_composer)

found_allocator=false
for path in /vendor/lib64/hw/gralloc.royd.so /vendor/lib/hw/gralloc.royd.so; do
  if [ -f "$path" ]; then
    found_allocator=true
    break
  fi
done

if [ "$found_allocator" = true ]; then
  setprop vendor.royd.graphics.allocator "$allocator"
  log "graphics: allocator $allocator ready"
else
  setprop vendor.royd.graphics.allocator unavailable
  warn "graphics: gralloc.royd module is missing"
fi

if [ -n "$composer" ]; then
  setprop vendor.royd.graphics.composer "$composer"
  log "graphics: composer HIDL $composer configured"
else
  setprop vendor.royd.graphics.composer unavailable
  warn "graphics: composer bridge version is missing"
fi

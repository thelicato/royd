#!/system/bin/sh

stdout=/proc/1/fd/1
stderr=/proc/1/fd/2
log() { printf '[royd] %s\n' "$*" > "$stdout"; }
warn() { printf '[royd] warning: %s\n' "$*" > "$stderr"; }

backend=$(getprop ro.vendor.royd.graphics_backend)
composer=$(getprop ro.vendor.royd.graphics_composer)
declared_allocator=$(getprop ro.vendor.royd.graphics_allocator)
mapper=$(getprop ro.vendor.royd.graphics_mapper)
gralloc=$(getprop ro.hardware.gralloc)

case "$declared_allocator" in
  aidl2-stablec5-memfd)
    if [ -x /vendor/bin/hw/android.hardware.graphics.allocator-service ] && \
       { [ -f /vendor/lib64/hw/mapper.royd.so ] || [ -f /vendor/lib/hw/mapper.royd.so ]; }; then
      setprop vendor.royd.graphics.allocator "$declared_allocator"
      setprop vendor.royd.graphics.mapper "$mapper"
      log "graphics: allocator $declared_allocator and mapper $mapper ready"
    else
      setprop vendor.royd.graphics.allocator unavailable
      warn "graphics: modern allocator or mapper is missing"
    fi
    ;;
  *)
    case "$backend" in
      software) allocator=gralloc0-memfd ;;
      host-gpu-generic) allocator=minigbm ;;
      host-gpu-intel) allocator=minigbm-intel ;;
      *) allocator=unknown ;;
    esac
    found_allocator=false
    for path in /vendor/lib64/hw/gralloc."$gralloc".so /vendor/lib/hw/gralloc."$gralloc".so; do
      if [ -f "$path" ]; then found_allocator=true; break; fi
    done
    if [ "$found_allocator" = true ]; then
      setprop vendor.royd.graphics.allocator "$allocator"
      log "graphics: allocator $allocator ready"
    else
      setprop vendor.royd.graphics.allocator unavailable
      warn "graphics: gralloc.$gralloc module is missing"
    fi
    ;;
esac

case "$composer" in
  aidl4-client)
    setprop vendor.royd.graphics.composer "$composer"
    log "graphics: composer AIDL current V4 client composition configured"
    ;;
  '')
    setprop vendor.royd.graphics.composer unavailable
    warn "graphics: composer contract is missing"
    ;;
  *)
    setprop vendor.royd.graphics.composer "$composer"
    log "graphics: composer HIDL $composer configured"
    ;;
esac

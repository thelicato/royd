#!/system/bin/sh

stdout=/proc/1/fd/1
stderr=/proc/1/fd/2

log() { printf '[royd] %s\n' "$*" > "$stdout"; }
warn() { printf '[royd] warning: %s\n' "$*" > "$stderr"; }
set_status() { setprop "vendor.royd.host.$1" "$2"; }

log "hardware: probing container host contract"
if /vendor/bin/royd-memfd-probe; then set_status memfd available; log "hardware: memfd with sealing available"; else set_status memfd unavailable; warn "memfd with sealing is unavailable"; fi
if [ -f /sys/fs/cgroup/cgroup.controllers ]; then set_status cgroup v2; log "hardware: cgroup v2 detected"; else set_status cgroup legacy; warn "cgroup v2 not detected"; fi
if [ -r /proc/pressure/memory ]; then set_status psi available; log "hardware: memory PSI available"; else set_status psi unavailable; warn "memory PSI is unavailable"; fi
render_node=
for node in /dev/dri/renderD*; do
  if [ -e "$node" ]; then
    render_node=$node
    break
  fi
done
if [ -n "$render_node" ]; then
  set_status dri available
  setprop vendor.royd.host.dri_render_node "$render_node"
  log "hardware: DRM render node available at $render_node"
else
  set_status dri unavailable
  setprop vendor.royd.host.dri_render_node none
  log "hardware: no DRM render node exposed"
fi

backend=$(getprop ro.vendor.royd.graphics_backend)
case "$backend" in
  software)
    setprop vendor.royd.graphics.mode software
    log "graphics: software renderer selected"
    ;;
  host-gpu-*)
    if [ -n "$render_node" ]; then
      setprop vendor.royd.graphics.mode host-gpu
      log "graphics: host GPU renderer selected ($backend via $render_node)"
    else
      setprop vendor.royd.graphics.mode unavailable
      warn "graphics: $backend requires at least one /dev/dri/renderD* node"
    fi
    ;;
  *)
    setprop vendor.royd.graphics.mode unavailable
    warn "graphics: unknown backend $backend"
    ;;
esac

 BandwidthController::BandwidthController() {
+    using namespace android::net;
+    if (royd::enabled()) {
+        mRoydGlobalAlert = std::make_unique<royd::GlobalAlert>(
+            [](royd::AlertSample& sample) {
+                const int result = royd::readGlobalAlert(sample);
+                if (result) ALOGE("ROYD: global alert sampling failed: %d", result);
+                return result;
+            },
+            [](uint64_t generation) {
+                const auto listeners = gCtls->eventReporter.getNetdUnsolicitedEventListenerMap();
+                bool success = !listeners.empty();
+                for (const auto& listener : listeners) {
+                    const auto result = listener.first->onQuotaLimitReached("globalAlert", "eth0");
+                    auto entry = gUnsolicitedLog.newEntry().function("onQuotaLimitReached")
+                            .args("globalAlert", "eth0");
+                    gUnsolicitedLog.log(entry.withAutomaticDuration());
+                    if (!result.isOk()) success = false;
+                }
+                if (!success) ALOGE("ROYD: global alert delivery failed for generation %" PRIu64,
+                                    generation);
+                return success;
+            });
+    }
+}

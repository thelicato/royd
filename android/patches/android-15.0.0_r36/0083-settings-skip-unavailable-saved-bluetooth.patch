         super(context, KEY);
+        mBluetoothUnavailable = Utils.isRoydHardwareUnavailable(context,
+                PackageManager.FEATURE_BLUETOOTH, PackageManager.FEATURE_BLUETOOTH_LE);

         DockUpdaterFeatureProvider dockUpdaterFeatureProvider =
                 FeatureFactory.getFeatureFactory().getDockUpdaterFeatureProvider();
         mSavedDockUpdater =
                 dockUpdaterFeatureProvider.getSavedDockUpdater(context, this);
-        mBluetoothAdapter = context.getSystemService(BluetoothManager.class).getAdapter();
+        mBluetoothAdapter = mBluetoothUnavailable ? null

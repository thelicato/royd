diff --git a/packages/modules/Connectivity/bpf/progs/royd_iface_account.h b/packages/modules/Connectivity/bpf/progs/royd_iface_account.h
new file mode 100644
--- /dev/null
+++ b/packages/modules/Connectivity/bpf/progs/royd_iface_account.h
@@ -0,0 +1,50 @@
+// Returns 1 for supported IP traffic, 0 for non-IP, -1 for unavailable accounting.
+// TCX presents Ethernet headers in both directions. Do not change packet contents.
+static __always_inline inline int royd_ip_counters(const struct __sk_buff* skb,
+                                                   uint64_t* bytes, uint64_t* packets) {
+    struct ethhdr eth;
+    if (bpf_skb_load_bytes(skb, 0, &eth, sizeof(eth))) return -1;
+    uint32_t l3len = skb->len - sizeof(eth);
+    uint32_t iplen, declared, transport;
+    if (eth.h_proto == htons(ETH_P_IP)) {
+        struct iphdr ip;
+        if (bpf_skb_load_bytes(skb, sizeof(eth), &ip, sizeof(ip))
+                || ip.version != 4 || ip.ihl < 5) return -1;
+        iplen = ip.ihl * 4;
+        declared = ntohs(ip.tot_len);
+        transport = ip.protocol;
+        if (skb->gso_segs > 1 && (ip.frag_off & htons(0x3fff))) return -1;
+    } else if (eth.h_proto == htons(ETH_P_IPV6)) {
+        struct ipv6hdr ip;
+        if (bpf_skb_load_bytes(skb, sizeof(eth), &ip, sizeof(ip))
+                || ip.version != 6) return -1;
+        iplen = sizeof(ip);
+        declared = iplen + ntohs(ip.payload_len);
+        transport = ip.nexthdr;
+    } else {
+        return 0;  // ARP and other L2 protocols are not IP-layer usage.
+    }
+    if (l3len < iplen || declared < iplen) return -1;
+    if (skb->gso_segs <= 1) {
+        if (eth.h_proto == htons(ETH_P_IPV6) && declared == iplen && l3len > iplen) return -1;
+        if (declared > l3len) return -1;
+        *bytes = declared;  // Exclude Ethernet padding as well as the Ethernet header.
+        *packets = 1;
+        return 1;
+    }
+    uint32_t headers = iplen;
+    if (transport == IPPROTO_TCP) {
+        struct tcphdr tcp;
+        if (bpf_skb_load_bytes(skb, sizeof(eth) + iplen, &tcp, sizeof(tcp))
+                || tcp.doff < 5) return -1;
+        headers += tcp.doff * 4;
+    } else if (transport == IPPROTO_UDP) {
+        headers += sizeof(struct udphdr);
+    } else {
+        return -1;  // Do not fabricate a segmentation estimate for unsupported GSO.
+    }
+    if (l3len < headers) return -1;
+    *packets = skb->gso_segs;
+    *bytes = (uint64_t)l3len + (uint64_t)(skb->gso_segs - 1) * headers;
+    return 1;
+}
diff --git a/system/netd/server/RoydInterfaceAccounting.h b/system/netd/server/RoydInterfaceAccounting.h
new file mode 100644
--- /dev/null
+++ b/system/netd/server/RoydInterfaceAccounting.h
@@ -0,0 +1,166 @@
+// royd's instance-owned interface accounting. Android 15 baseline only.
+#pragma once
+
+#include <android-base/unique_fd.h>
+#include <errno.h>
+#include <linux/bpf.h>
+#include <net/if.h>
+#include <net/if_arp.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+namespace android::net::royd {
+using android::base::unique_fd;
+constexpr const char* kRoot = "/sys/fs/bpf/netd_shared/";
+struct AccountingState { uint32_t ifindex; uint32_t errors; };
+struct Counters { uint64_t rxPackets, rxBytes, txPackets, txBytes; };
+
+inline bool enabled() {
+    const char* marker = getenv("ROYD_CONTAINER");
+    if (!marker || strcmp(marker, "1")) return false;
+    struct stat st;
+    return stat("/sys/fs/selinux/enforce", &st) == -1 && errno == ENOENT;
+}
+
+inline int bpfCall(enum bpf_cmd cmd, union bpf_attr& attr) {
+    return syscall(__NR_bpf, cmd, &attr, sizeof(attr));
+}
+inline bool preserveQdisc(const char* iface) {
+    return !strcmp(iface, "eth0") && enabled();
+}
+inline int object(const char* name) {
+    std::string path = std::string(kRoot) + name;
+    union bpf_attr attr = {};
+    attr.pathname = reinterpret_cast<uintptr_t>(path.c_str());
+    return bpfCall(BPF_OBJ_GET, attr);
+}
+template <typename T> inline bool info(int fd, T& value, uint32_t minimum) {
+    union bpf_attr attr = {};
+    attr.info.bpf_fd = fd;
+    attr.info.info_len = sizeof(value);
+    attr.info.info = reinterpret_cast<uintptr_t>(&value);
+    return bpfCall(BPF_OBJ_GET_INFO_BY_FD, attr) == 0
+            && attr.info.info_len >= minimum;
+}
+inline bool mapLayout(int fd, uint32_t type, uint32_t size) {
+    struct bpf_map_info mi = {};
+    return info(fd, mi, offsetof(bpf_map_info, max_entries) + sizeof(mi.max_entries))
+            && mi.type == type && mi.key_size == sizeof(uint32_t)
+            && mi.value_size == size && mi.max_entries > 0
+            && (type != BPF_MAP_TYPE_ARRAY || mi.max_entries == 1);
+}
+template <typename T> inline bool lookup(int fd, uint32_t key, T& value) {
+    union bpf_attr attr = {};
+    attr.map_fd = fd;
+    attr.key = reinterpret_cast<uintptr_t>(&key);
+    attr.value = reinterpret_cast<uintptr_t>(&value);
+    return bpfCall(BPF_MAP_LOOKUP_ELEM, attr) == 0;
+}
+template <typename T> inline int update(int fd, uint32_t key, const T& value, uint64_t flags) {
+    union bpf_attr attr = {};
+    attr.map_fd = fd;
+    attr.key = reinterpret_cast<uintptr_t>(&key);
+    attr.value = reinterpret_cast<uintptr_t>(&value);
+    attr.flags = flags;
+    return bpfCall(BPF_MAP_UPDATE_ELEM, attr);
+}
+inline bool validLink(int fd, int prog, uint32_t ifindex, uint32_t direction) {
+    struct bpf_link_info li = {};
+    struct bpf_prog_info pi = {};
+    if (!info(fd, li, offsetof(bpf_link_info, tcx) + sizeof(li.tcx))
+            || !info(prog, pi, offsetof(bpf_prog_info, id) + sizeof(pi.id))
+            || li.type != BPF_LINK_TYPE_TCX
+            || pi.type != BPF_PROG_TYPE_SCHED_CLS || li.prog_id != pi.id
+            || li.tcx.ifindex != ifindex || li.tcx.attach_type != direction) return false;
+    // A matching ifindex alone cannot prove membership in this network namespace.
+    uint32_t ids[64] = {}, links[64] = {};
+    union bpf_attr query = {};
+    query.query.target_ifindex = ifindex;
+    query.query.attach_type = direction;
+    query.query.prog_cnt = 64;
+    query.query.prog_ids = reinterpret_cast<uintptr_t>(ids);
+    query.query.link_ids = reinterpret_cast<uintptr_t>(links);
+    if (bpfCall(BPF_PROG_QUERY, query) || query.query.prog_cnt > 64) return false;
+    for (uint32_t i = 0; i < query.query.prog_cnt; ++i) {
+        if (ids[i] == pi.id && links[i] == li.id) return true;
+    }
+    return false;
+}
+inline bool link(uint32_t ifindex, bool ingress, bool create) {
+    const char* program = ingress ? "prog_netd_schedcls_royd_ingress_account"
+                                 : "prog_netd_schedcls_royd_egress_account";
+    const char* pin = ingress ? "link_royd_iface_ingress" : "link_royd_iface_egress";
+    const uint32_t direction = ingress ? BPF_TCX_INGRESS : BPF_TCX_EGRESS;
+    unique_fd prog(object(program));
+    if (!prog.ok()) return false;
+    unique_fd fd(object(pin));
+    if (!fd.ok()) {
+        if (!create || errno != ENOENT) return false;
+        union bpf_attr attr = {};
+        attr.link_create.prog_fd = prog.get();
+        attr.link_create.target_ifindex = ifindex;
+        attr.link_create.attach_type = direction;
+        // Insert before existing links, without replacing any link or clsact filter.
+        attr.link_create.flags = BPF_F_BEFORE;
+        fd.reset(bpfCall(BPF_LINK_CREATE, attr));
+        if (!fd.ok()) return false;
+        std::string path = std::string(kRoot) + pin;
+        attr = {};
+        attr.bpf_fd = fd.get();
+        attr.pathname = reinterpret_cast<uintptr_t>(path.c_str());
+        if (bpfCall(BPF_OBJ_PIN, attr)) return false;
+    }
+    // Never delete or adopt a mismatching pin, including a detached/recycled device.
+    return validLink(fd.get(), prog.get(), ifindex, direction);
+}
+inline bool ready(uint32_t& ifindex, uint32_t& errors) {
+    ifindex = if_nametoindex("eth0");
+    unique_fd map(object("map_netd_royd_iface_accounting_map"));
+    unique_fd stats(object("map_netd_iface_stats_map"));
+    AccountingState state = {};
+    Counters counters = {};
+    if (!ifindex || !map.ok() || !mapLayout(map.get(), BPF_MAP_TYPE_ARRAY, sizeof(state))
+            || !lookup(map.get(), 0, state) || !stats.ok()
+            || !mapLayout(stats.get(), BPF_MAP_TYPE_HASH, sizeof(counters))
+            || !lookup(stats.get(), ifindex, counters)) return false;
+    errors = state.errors;
+    return state.ifindex == ifindex && !errors
+            && link(ifindex, true, false) && link(ifindex, false, false);
+}
+inline bool initialise() {
+    if (!enabled()) return true;
+    unique_fd socketFd(socket(AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, 0));
+    struct ifreq request = {};
+    strcpy(request.ifr_name, "eth0");
+    if (!socketFd.ok() || ioctl(socketFd.get(), SIOCGIFHWADDR, &request)
+            || request.ifr_hwaddr.sa_family != ARPHRD_ETHER) return false;
+    const uint32_t ifindex = if_nametoindex("eth0");
+    unique_fd map(object("map_netd_royd_iface_accounting_map"));
+    unique_fd stats(object("map_netd_iface_stats_map"));
+    AccountingState state = {};
+    Counters zero = {};
+    if (!ifindex || ifindex == 1 || !map.ok() || !stats.ok()
+            || !mapLayout(map.get(), BPF_MAP_TYPE_ARRAY, sizeof(state))
+            || !mapLayout(stats.get(), BPF_MAP_TYPE_HASH, sizeof(zero))
+            || !lookup(map.get(), 0, state) || state.errors
+            || (state.ifindex && state.ifindex != ifindex)) return false;
+    // Preserve boot-monotonic totals across netd/framework restarts.
+    if (update(stats.get(), ifindex, zero, BPF_NOEXIST) && errno != EEXIST) return false;
+    if (!link(ifindex, true, true) || !link(ifindex, false, true)) return false;
+    // Activate only after both owned links are attached and verified.
+    if (!state.ifindex) {
+        state.ifindex = ifindex;
+        if (update(map.get(), 0, state, BPF_EXIST)) return false;
+    }
+    uint32_t current = 0, errors = 0;
+    return ready(current, errors);
+}
+}  // namespace android::net::royd

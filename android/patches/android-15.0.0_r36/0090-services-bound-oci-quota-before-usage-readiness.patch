+    @GuardedBy("mNetworkPoliciesSecondLock")
+    private long roydInterfaceQuotaLimit(String iface, long limitBytes, boolean awaitingUsage) {
+        if (awaitingUsage && "eth0".equals(iface)) {
+            // Zero means not ready, not an unused cycle. Do not regrant history.
+            // A real usage callback recalculates the normal allowance; exhaustion
+            // keeps the existing hard-limit feedback and stock polling path.
+            if (!mRoydQuotaUsageWaitReported) {
+                mRoydQuotaUsageWaitReported = true;
+                Slog.i(TAG, "ROYD: holding OCI Ethernet quotas at one byte until usage is ready");
+            }
+            return 1;
+        }
+        return limitBytes;
+    }
+
     @Deprecated
     private long getTotalBytes(NetworkTemplate template, long start, long end) {
         // Skip if not ready. NetworkStatsService will block public API calls until it is
         // ready. To prevent NPMS be blocked on that, skip and fail fast instead.
         if (!mStatsCallback.isAnyCallbackReceived()) return 0;
         return mDeps.getNetworkTotalBytes(template, start, end);
     }

     private boolean isBandwidthControlEnabled() {
         final long token = Binder.clearCallingIdentity();
         try {
             return mNetworkManager.isBandwidthControlEnabled();
         } catch (RemoteException e) {
             // ignored; service lives in system_server
             return false;
         } finally {
             Binder.restoreCallingIdentity(token);
         }

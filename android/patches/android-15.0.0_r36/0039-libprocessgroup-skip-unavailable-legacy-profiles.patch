+bool ShouldSkipRoydLegacyCgroup(const CgroupControllerWrapper& controller) {
+    const char* royd_container = getenv("ROYD_CONTAINER");
+    if (royd_container == nullptr || strcmp(royd_container, "1") != 0 ||
+        access("/sys/fs/selinux/enforce", F_OK) == 0 || controller.version() != 1) {
+        return false;
+    }
+
+    errno = 0;
+    return access(controller.path(), F_OK) != 0 && errno == ENOENT;
+}

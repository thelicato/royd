+    private final boolean mObserveRoydEthernetStats = shouldObserveRoydEthernetStats();
+
+    private static boolean shouldObserveRoydEthernetStats() {
+        if (!"1".equals(System.getenv("ROYD_CONTAINER"))) return false;
+        try {
+            android.system.Os.stat("/sys/fs/selinux/enforce");
+            return false;
+        } catch (android.system.ErrnoException error) {
+            return error.errno == android.system.OsConstants.ENOENT;
+        }
+    }
+
+    private void registerNetworkStatsCallbacks(Executor executor) {
+        mNetworkStats.registerUsageCallback(new NetworkTemplate.Builder(MATCH_MOBILE).build(),
+                0 /* thresholdBytes */, executor, mStatsCallback);
+        mNetworkStats.registerUsageCallback(new NetworkTemplate.Builder(MATCH_WIFI).build(),
+                0 /* thresholdBytes */, executor, mStatsCallback);
+        if (mObserveRoydEthernetStats) {
+            // Keep the readiness guard dependent on real usage of the OCI transport.
+            mNetworkStats.registerUsageCallback(
+                    new NetworkTemplate.Builder(NetworkTemplate.MATCH_ETHERNET).build(),
+                    0 /* thresholdBytes */, executor, mStatsCallback);
+            Slog.i(TAG, "ROYD: observing OCI Ethernet usage for network policy");
+        }
+    }

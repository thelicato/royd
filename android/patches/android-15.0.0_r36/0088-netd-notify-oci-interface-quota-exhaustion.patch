@@ -0,0 +1,46 @@
+/* Copyright 2026 The royd Authors. SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include "RoydInterfaceQuota.h"
+#include "RoydQuotaEvents.h"
+
+namespace android::net::royd {
+inline int readQuotaEvent(QuotaEventSample& sample) {
+    std::lock_guard guard(quotaMutex());
+    uint32_t index = 0;
+    if (!quotaReady(index)) return -EIO;
+    unique_fd budget(object("map_roydquota_quota_budget"));
+    unique_fd faults(object("map_roydquota_quota_drops"));
+    unique_fd accounting(object("map_netd_iface_stats_map"));
+    if (!budget.ok() || !faults.ok() || !accounting.ok()) return -EIO;
+    QuotaDrops drops = {};
+    if (!lookup(faults.get(), 0, drops) || drops.invalid || drops.contention) return -EIO;
+    QuotaValue value = {};
+    sample.present = lookup(budget.get(), index, value);
+    if (!sample.present && errno != ENOENT) return -EIO;
+    if (sample.present && (!value.generation || !value.limit || value.limit > INT64_MAX
+            || value.remaining > value.limit)) return -EIO;
+    sample.identity[0] = index;
+    const int maps[] = {budget.get(), faults.get(), accounting.get()};
+    for (unsigned n = 0; n < 3; ++n) {
+        struct bpf_map_info map = {};
+        if (!info(maps[n], map, offsetof(bpf_map_info, id) + sizeof(map.id)) || !map.id) return -EIO;
+        sample.identity[n + 1] = map.id;
+    }
+    const char* names[] = {"link_royd_iface_ingress", "link_royd_iface_egress",
+                           "link_royd_quota_ingress", "link_royd_quota_egress"};
+    for (unsigned n = 0; n < 4; ++n) {
+        unique_fd fd(object(names[n]));
+        struct bpf_link_info link = {};
+        if (!fd.ok() || !info(fd.get(), link, offsetof(bpf_link_info, id) + sizeof(link.id))
+                || !link.id) return -EIO;
+        sample.identity[n + 4] = link.id;
+    }
+    uint32_t current = 0;
+    if (!quotaReady(current) || current != index || !lookup(faults.get(), 0, drops)
+            || drops.invalid || drops.contention) return -EIO;
+    sample.generation = value.generation;
+    sample.limit = value.limit;
+    sample.remaining = value.remaining;
+    return 0;
+}
+} // namespace android::net::royd

diff --git a/system/netd/server/RoydQuotaEvents.h b/system/netd/server/RoydQuotaEvents.h
new file mode 100644
index 0000000000000000000000000000000000000000..bcd887defca20147a90c1aea0b1e7fe28cf3ca97
--- /dev/null
+++ b/system/netd/server/RoydQuotaEvents.h
@@ -0,0 +1,180 @@
+/* Copyright 2026 The royd Authors. SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include <array>
+#include <cerrno>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <pthread.h>
+#include <utility>
+
+namespace android::net::royd {
+struct QuotaEventSample {
+    // Interface, budget/drop/accounting maps and all four production links.
+    std::array<uint32_t, 8> identity{};
+    uint64_t generation = 0, limit = 0, remaining = 0;
+    bool present = false;
+};
+
+// Observe an exhausted kernel budget. Packet enforcement stays in TCX.
+class QuotaEvents {
+  public:
+    using Read = std::function<int(QuotaEventSample&)>;
+    using Set = std::function<int(int64_t, uint64_t&)>;
+    using Remove = std::function<int()>;
+    using Notify = std::function<bool(uint64_t)>;
+    using Start = int (*)(pthread_t*, const pthread_attr_t*, void* (*)(void*), void*);
+    struct Status {
+        uint64_t generation = 0, bytes = 0, committed = 0;
+        bool armed = false, started = false;
+        int error = 0;
+    };
+    QuotaEvents(Read read, Set set, Remove remove, Notify notify,
+                std::chrono::milliseconds interval = std::chrono::milliseconds(250),
+                Start start = pthread_create)
+        : mRead(std::move(read)), mSet(std::move(set)), mRemove(std::move(remove)),
+          mNotify(std::move(notify)), mInterval(interval), mStart(start) {}
+    ~QuotaEvents() {
+        {
+            std::lock_guard guard(mLock);
+            mStop = true;
+            mChanged.notify_all();
+        }
+        if (mState.started) pthread_join(mThread, nullptr);
+    }
+    QuotaEvents(const QuotaEvents&) = delete;
+    QuotaEvents& operator=(const QuotaEvents&) = delete;
+
+    int set(int64_t bytes) {
+        if (bytes <= 0) return -ERANGE;
+        std::lock_guard guard(mLock);
+        if (mState.error) return -mState.error;
+        if (mEpoch == UINT64_MAX) return -EOVERFLOW;
+        QuotaEventSample sample;
+        const int result = mRead(sample);
+        if (result) return result;
+        if (!valid(sample)) return -ENODATA;
+        if (mHaveSource && (sample.identity != mIdentity
+                || (mState.bytes ? !installed(sample) : sample.present))) {
+            failLocked(ESTALE);
+            return -ESTALE;
+        }
+        if (!mState.started) {
+            const int error = mStart(&mThread, nullptr, work, this);
+            if (error) return -error;
+            mState.started = true;
+        }
+        uint64_t generation = 0;
+        const int update = mSet(bytes, generation);
+        if (update) return update; // The old policy/window survives a failed write.
+        if (!generation) {
+            failLocked(EIO);
+            return -EIO;
+        }
+        mHaveSource = true;
+        mIdentity = sample.identity;
+        mState.generation = generation;
+        mState.bytes = uint64_t(bytes);
+        mLastRemaining = uint64_t(bytes);
+        // A distinct lifecycle epoch also protects a reinstalled kernel
+        // generation after removal on a coarse monotonic clock.
+        ++mEpoch;
+        mState.armed = true;
+        mChanged.notify_all();
+        return 0;
+    }
+    int remove() {
+        std::lock_guard guard(mLock);
+        const int result = mRemove();
+        if (!result) {
+            mState.bytes = 0;
+            mState.armed = false;
+            mChanged.notify_all();
+        }
+        return result;
+    }
+    Status status() {
+        std::lock_guard guard(mLock);
+        return mState;
+    }
+
+  private:
+    static bool valid(const QuotaEventSample& sample) {
+        if (sample.identity[0] <= 1) return false;
+        for (const auto id : sample.identity) if (!id) return false;
+        for (unsigned a = 1; a < 4; ++a)
+            for (unsigned b = a + 1; b < 4; ++b)
+                if (sample.identity[a] == sample.identity[b]) return false;
+        for (unsigned a = 4; a < 8; ++a)
+            for (unsigned b = a + 1; b < 8; ++b)
+                if (sample.identity[a] == sample.identity[b]) return false;
+        return sample.present
+                ? sample.generation && sample.limit && sample.limit <= INT64_MAX
+                        && sample.remaining <= sample.limit
+                : !sample.generation && !sample.limit && !sample.remaining;
+    }
+    bool installed(const QuotaEventSample& sample) const {
+        return sample.present && sample.generation == mState.generation
+                && sample.limit == mState.bytes && sample.remaining <= mLastRemaining;
+    }
+    void failLocked(int error) {
+        mState.error = error;
+        mState.armed = false;
+    }
+    static void* work(void* self) {
+        static_cast<QuotaEvents*>(self)->run();
+        return nullptr;
+    }
+    void run() {
+        pthread_setname_np(pthread_self(), "royd-quota-msg");
+        std::unique_lock guard(mLock);
+        while (!mStop) {
+            if (!mState.armed) {
+                mChanged.wait(guard, [&] { return mStop || mState.armed; });
+                continue;
+            }
+            const uint64_t epoch = mEpoch;
+            if (mChanged.wait_for(guard, mInterval, [&] {
+                    return mStop || !mState.armed || epoch != mEpoch;
+                })) continue;
+            // Serialise the bounded BPF read and commitment with quota writes.
+            QuotaEventSample sample;
+            const int result = mRead(sample);
+            if (result || !valid(sample)) {
+                failLocked(result < 0 ? -result : EIO);
+                continue;
+            }
+            if (sample.identity != mIdentity || !installed(sample)) {
+                failLocked(ESTALE);
+                continue;
+            }
+            mLastRemaining = sample.remaining;
+            if (sample.remaining) continue;
+            mState.armed = false;
+            ++mState.committed;
+            const uint64_t generation = mState.generation;
+            // Committed delivery cannot be recalled. No quota, alert or
+            // BandwidthController lock is held while calling Binder listeners.
+            guard.unlock();
+            const bool delivered = mNotify(generation);
+            guard.lock();
+            if (!delivered && epoch == mEpoch && mState.bytes) failLocked(EIO);
+        }
+    }
+    Read mRead;
+    Set mSet;
+    Remove mRemove;
+    Notify mNotify;
+    const std::chrono::milliseconds mInterval;
+    Start mStart;
+    std::mutex mLock;
+    std::condition_variable mChanged;
+    pthread_t mThread{};
+    bool mStop = false, mHaveSource = false;
+    uint64_t mEpoch = 0, mLastRemaining = 0;
+    std::array<uint32_t, 8> mIdentity{};
+    Status mState;
+};
+} // namespace android::net::royd

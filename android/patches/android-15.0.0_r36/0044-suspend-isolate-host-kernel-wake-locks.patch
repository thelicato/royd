+static bool ShouldSkipRoydHostPowerWrite(const std::string& path) {
+    if (path != "/sys/power/state" && path != "/sys/power/wakeup_count" &&
+        path != "/sys/power/wake_lock" && path != "/sys/power/wake_unlock") {
+        return false;
+    }
+    const char* container = getenv("ROYD_CONTAINER");
+    return container != nullptr && strcmp(container, "1") == 0 && is_selinux_enabled() <= 0;
+}

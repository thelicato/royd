+const SYSTEM_UID: u32 = 1000;
+const LOCK_SETTINGS_NAMESPACE: i64 = 103;
+
+fn royd_missing_sid_fallback_enabled() -> bool {
+    std::env::var("ROYD_CONTAINER").as_deref() == Ok("1") && selinux::is_selinux_enabled() <= 0
+}
+
+/// Preserve stock Binder features except when caller SIDs are unavailable in a royd container.
+pub fn binder_features(mut features: BinderFeatures) -> BinderFeatures {
+    if royd_missing_sid_fallback_enabled() {
+        warn!(
+            "ROYD: suppressing Keystore2 Binder caller SID request because ROYD_CONTAINER=1 and kernel SELinux is disabled"
+        );
+        features.set_requesting_sid = false;
+    }
+    features
+}

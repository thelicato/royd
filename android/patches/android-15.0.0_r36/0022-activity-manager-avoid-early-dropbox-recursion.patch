@@ -9814,10 +9815,18 @@ public class ActivityManagerService extends IActivityManager.Stub
         // NOTE -- this must never acquire the ActivityManagerService lock,
         // otherwise the watchdog may be prevented from resetting the system.
 
+        // Container-specific WTFs can occur before SystemServer publishes DropBox. Avoid asking
+        // SystemServiceRegistry for the absent service because that missing-service WTF would be
+        // reported through this method again. Normal persistence resumes once DropBox exists.
+        if ("1".equals(System.getenv("ROYD_CONTAINER")) && !SELinux.isSELinuxEnabled()
+                && ServiceManager.checkService(Context.DROPBOX_SERVICE) == null) {
+            return;
+        }
+
         // Bail early if not published yet
         final DropBoxManager dbox;
         try {
             dbox = mContext.getSystemService(DropBoxManager.class);
         } catch (Exception e) {
             return;
         }

diff --git a/system/netd/server/RoydInterfaceAlert.h b/system/netd/server/RoydInterfaceAlert.h
new file mode 100644
--- /dev/null
+++ b/system/netd/server/RoydInterfaceAlert.h
@@ -0,0 +1,163 @@
+/* Copyright 2026 The royd Authors. SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include <array>
+#include <cerrno>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <limits>
+#include <mutex>
+#include <pthread.h>
+#include <utility>
+
+namespace android::net::royd {
+struct InterfaceAlertSample {
+    // Interface, usage map, accounting links and quota links identify the source.
+    std::array<uint32_t, 6> identity{};
+    uint64_t admitted = 0;
+};
+
+// A delayed notification of quota-admitted IP bytes, never quota enforcement.
+class InterfaceAlert {
+  public:
+    using Read = std::function<int(InterfaceAlertSample&)>;
+    using Remove = std::function<int()>;
+    using Notify = std::function<bool(uint64_t)>;
+    using Start = int (*)(pthread_t*, const pthread_attr_t*, void* (*)(void*), void*);
+    struct Status {
+        uint64_t generation = 0, bytes = 0, committed = 0;
+        bool armed = false;
+        int error = 0;
+    };
+    InterfaceAlert(Read read, Remove remove, Notify notify,
+                   std::chrono::milliseconds interval = std::chrono::milliseconds(250),
+                   Start start = pthread_create)
+        : mRead(std::move(read)), mRemove(std::move(remove)), mNotify(std::move(notify)),
+          mInterval(interval), mStart(start) {}
+    ~InterfaceAlert() {
+        {
+            std::lock_guard guard(mLock);
+            mStop = true;
+            mChanged.notify_all();
+        }
+        if (mStarted) pthread_join(mThread, nullptr);
+    }
+    InterfaceAlert(const InterfaceAlert&) = delete;
+    InterfaceAlert& operator=(const InterfaceAlert&) = delete;
+
+    int arm(int64_t bytes) {
+        if (bytes <= 0) return -ERANGE;
+        std::lock_guard guard(mLock);
+        if (mState.error) return -mState.error;
+        if (mState.generation == UINT64_MAX) return -EOVERFLOW;
+        InterfaceAlertSample sample;
+        const int result = mRead(sample); // Also requires an installed quota.
+        if (result) return result;
+        if (!valid(sample)) return -ENODATA;
+        if (mHaveSource && (sample.identity != mLast.identity || sample.admitted < mLast.admitted)) {
+            failLocked(ESTALE);
+            return -ESTALE;
+        }
+        if (!mStarted) {
+            const int error = mStart(&mThread, nullptr, work, this);
+            if (error) return -error;
+            mStarted = true;
+        }
+        mHaveSource = true;
+        mBase = mLast = sample;
+        ++mState.generation;
+        mState.bytes = uint64_t(bytes);
+        mState.armed = true;
+        mChanged.notify_all();
+        return 0;
+    }
+    int cancel() {
+        std::lock_guard guard(mLock);
+        if (!mState.bytes) return -ENOENT;
+        // Disarming under the sampling lock invalidates any uncommitted event.
+        cancelLocked();
+        return 0;
+    }
+    int removeQuota() {
+        std::lock_guard guard(mLock);
+        // Sampling, removal and cancellation share one lock. Failed deletion
+        // retains the prior registration. No sampler can fault on the gap.
+        const int result = mRemove();
+        if (!result) cancelLocked();
+        return result;
+    }
+    Status status() {
+        std::lock_guard guard(mLock);
+        return mState;
+    }
+
+  private:
+    static bool valid(const InterfaceAlertSample& sample) {
+        if (sample.identity[0] <= 1) return false;
+        for (const auto id : sample.identity) if (!id) return false;
+        return sample.identity[2] != sample.identity[3]
+                && sample.identity[4] != sample.identity[5];
+    }
+    void cancelLocked() {
+        mState.bytes = 0;
+        mState.armed = false;
+        mChanged.notify_all();
+    }
+    void failLocked(int error) {
+        mState.error = error;
+        mState.armed = false;
+    }
+    static void* work(void* self) {
+        static_cast<InterfaceAlert*>(self)->run();
+        return nullptr;
+    }
+    void run() {
+        pthread_setname_np(pthread_self(), "royd-if-alert");
+        std::unique_lock guard(mLock);
+        while (!mStop) {
+            if (!mState.armed) {
+                mChanged.wait(guard, [&] { return mStop || mState.armed; });
+                continue;
+            }
+            const uint64_t generation = mState.generation;
+            if (mChanged.wait_for(guard, mInterval, [&] {
+                    return mStop || !mState.armed || generation != mState.generation;
+                })) continue;
+            // Reads are bounded local BPF syscalls. Keeping the lifecycle lock
+            // through the read serialises quota removal with event commitment.
+            InterfaceAlertSample sample;
+            const int result = mRead(sample);
+            if (result || !valid(sample)) {
+                failLocked(result < 0 ? -result : EIO);
+                continue;
+            }
+            if (sample.identity != mLast.identity || sample.admitted < mLast.admitted) {
+                failLocked(ESTALE);
+                continue;
+            }
+            mLast = sample;
+            if (sample.admitted - mBase.admitted < mState.bytes) continue;
+            mState.armed = false;
+            ++mState.committed;
+            // Already committed Binder delivery cannot be recalled. No alert,
+            // quota or BandwidthController lock is held by this callback thread.
+            guard.unlock();
+            const bool delivered = mNotify(generation);
+            guard.lock();
+            if (!delivered && generation == mState.generation && mState.bytes) failLocked(EIO);
+        }
+    }
+    Read mRead;
+    Remove mRemove;
+    Notify mNotify;
+    const std::chrono::milliseconds mInterval;
+    Start mStart;
+    std::mutex mLock;
+    std::condition_variable mChanged;
+    pthread_t mThread{};
+    bool mStarted = false, mStop = false, mHaveSource = false;
+    InterfaceAlertSample mBase, mLast;
+    Status mState;
+};
+} // namespace android::net::royd
diff --git a/system/netd/server/RoydInterfaceAlertSource.h b/system/netd/server/RoydInterfaceAlertSource.h
new file mode 100644
--- /dev/null
+++ b/system/netd/server/RoydInterfaceAlertSource.h
@@ -0,0 +1,42 @@
+/* Copyright 2026 The royd Authors. SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include "RoydInterfaceAlert.h"
+#include "RoydInterfaceQuota.h"
+
+namespace android::net::royd {
+inline int readInterfaceAlert(InterfaceAlertSample& sample) {
+    // All controller quota writes use the same mutex. The admitted counter is
+    // updated only by packets, never reset by quota replacement or netd restart.
+    std::lock_guard guard(quotaMutex());
+    uint32_t index = 0;
+    if (!quotaReady(index)) return -EIO;
+    unique_fd budget(object("map_roydquota_quota_budget"));
+    unique_fd usage(object("map_roydquota_quota_admitted"));
+    unique_fd faults(object("map_roydquota_quota_drops"));
+    if (!budget.ok() || !usage.ok() || !faults.ok()) return -EIO;
+    QuotaValue value = {};
+    if (!lookup(budget.get(), index, value)) return errno == ENOENT ? -ENOENT : -EIO;
+    if (!value.generation || !value.limit || value.limit > INT64_MAX
+            || value.remaining > value.limit) return -EIO;
+    QuotaDrops drops = {};
+    if (!lookup(faults.get(), 0, drops) || drops.invalid || drops.contention) return -EIO;
+    struct bpf_map_info map = {};
+    if (!info(usage.get(), map, offsetof(bpf_map_info, id) + sizeof(map.id)) || !map.id
+            || !lookup(usage.get(), 0, sample.admitted)) return -EIO;
+    sample.identity[0] = index;
+    sample.identity[1] = map.id;
+    const char* names[] = {"link_royd_iface_ingress", "link_royd_iface_egress",
+                           "link_royd_quota_ingress", "link_royd_quota_egress"};
+    for (unsigned n = 0; n < 4; ++n) {
+        unique_fd fd(object(names[n]));
+        struct bpf_link_info link = {};
+        if (!fd.ok() || !info(fd.get(), link, offsetof(bpf_link_info, id) + sizeof(link.id))
+                || !link.id) return -EIO;
+        sample.identity[n + 2] = link.id;
+    }
+    uint32_t current = 0;
+    if (!quotaReady(current) || current != index || !lookup(faults.get(), 0, drops)
+            || drops.invalid || drops.contention) return -EIO;
+    return 0;
+}
+} // namespace android::net::royd

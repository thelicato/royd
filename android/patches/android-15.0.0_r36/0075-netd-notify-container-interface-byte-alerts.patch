+
+// Record only successful reservations. Refuse overflow or bounded contention
+// without exposing a wrapped zero counter to an alert registration.
+static __always_inline inline int royd_quota_record(uint64_t* total, uint64_t bytes) {
+    uint64_t old = __sync_val_compare_and_swap(total, 0, 0);
+#ifdef __clang__
+#pragma clang loop unroll(disable)
+#endif
+    for (unsigned attempt = 0; attempt < 64; ++attempt) {
+        if (!bytes || old > UINT64_MAX - bytes) return -1;
+        uint64_t observed = __sync_val_compare_and_swap(total, old, old + bytes);
+        if (observed == old) return 1;
+        old = observed;
+    }
+    return -2;
+}


diff --git a/packages/modules/StatsD/statsd/src/main.cpp b/packages/modules/StatsD/statsd/src/main.cpp
--- a/packages/modules/StatsD/statsd/src/main.cpp
+++ b/packages/modules/StatsD/statsd/src/main.cpp
@@ -25,3 +25,5 @@
 #include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
 #include <sys/random.h>
 #include <sys/stat.h>
@@ -82,2 +84,8 @@
+static bool IsRoydContainerWithoutSelinux() {
+    const char* royd_container = getenv("ROYD_CONTAINER");
+    return royd_container != nullptr && strcmp(royd_container, "1") == 0 &&
+            access("/sys/fs/selinux/enforce", F_OK) != 0;
+}
+
 int main(int /*argc*/, char** /*argv*/) {
     // Set up the looper
@@ -118,3 +126,8 @@
     if (__builtin_available(android __ANDROID_API_U__, *)) {
-        AIBinder_setRequestingSid(binder.get(), true);
+        const bool request_sid = !IsRoydContainerWithoutSelinux();
+        AIBinder_setRequestingSid(binder.get(), request_sid);
+        if (!request_sid) {
+            ALOGI("ROYD: suppressing statsd Binder caller SID request because ROYD_CONTAINER=1 "
+                  "and kernel SELinux is disabled");
+        }
     }

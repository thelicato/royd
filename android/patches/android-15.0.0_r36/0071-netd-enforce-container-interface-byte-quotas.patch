diff --git a/system/netd/server/RoydInterfaceQuota.h b/system/netd/server/RoydInterfaceQuota.h
--- /dev/null
+++ b/system/netd/server/RoydInterfaceQuota.h
@@ -0,0 +1,130 @@
+/* Copyright 2026 The royd Authors. SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include <limits>
+#include <mutex>
+#include <time.h>
+#include "RoydInterfaceAccounting.h"
+
+namespace android::net::royd {
+struct QuotaValue { uint64_t remaining, limit, generation; };
+struct QuotaDrops { uint64_t invalid, contention; };
+static_assert(sizeof(QuotaValue) == 24 && sizeof(QuotaDrops) == 16);
+inline std::mutex& quotaMutex() { static std::mutex mutex; return mutex; }
+
+inline bool quotaMap(int fd) {
+    struct bpf_map_info map = {};
+    return info(fd, map, offsetof(bpf_map_info, map_flags) + sizeof(map.map_flags))
+            && map.type == BPF_MAP_TYPE_HASH && map.key_size == sizeof(uint32_t)
+            && map.value_size == sizeof(QuotaValue) && map.max_entries == 1
+            && map.map_flags == BPF_F_NO_PREALLOC;
+}
+inline bool quotaLink(uint32_t index, bool ingress, bool create) {
+    const uint32_t direction = ingress ? BPF_TCX_INGRESS : BPF_TCX_EGRESS;
+    const char* pin = ingress ? "link_royd_quota_ingress" : "link_royd_quota_egress";
+    unique_fd program(object(ingress ? "prog_roydquota_schedcls_ingress"
+                                    : "prog_roydquota_schedcls_egress"));
+    unique_fd accounting(object(ingress ? "link_royd_iface_ingress" : "link_royd_iface_egress"));
+    struct bpf_link_info prior = {};
+    if (!program.ok() || !accounting.ok()
+            || !info(accounting.get(), prior, offsetof(bpf_link_info, id) + sizeof(prior.id))) return false;
+    unique_fd fd(object(pin));
+    if (!fd.ok()) {
+        if (!create || errno != ENOENT) return false;
+        union bpf_attr attr = {};
+        attr.link_create.prog_fd = program.get();
+        attr.link_create.target_ifindex = index;
+        attr.link_create.attach_type = direction;
+        attr.link_create.flags = BPF_F_AFTER | BPF_F_LINK | BPF_F_ID;
+        attr.link_create.tcx.relative_id = prior.id;
+        fd.reset(bpfCall(BPF_LINK_CREATE, attr));
+        if (!fd.ok()) return false;
+        std::string path = std::string(kRoot) + pin;
+        attr = {};
+        attr.bpf_fd = fd.get();
+        attr.pathname = reinterpret_cast<uintptr_t>(path.c_str());
+        if (bpfCall(BPF_OBJ_PIN, attr)) return false;
+    }
+    if (!validLink(fd.get(), program.get(), index, direction)) return false;
+    struct bpf_link_info own = {};
+    uint32_t ids[64] = {};
+    union bpf_attr query = {};
+    query.query.target_ifindex = index;
+    query.query.attach_type = direction;
+    query.query.prog_cnt = 64;
+    query.query.link_ids = reinterpret_cast<uintptr_t>(ids);
+    if (!info(fd.get(), own, offsetof(bpf_link_info, id) + sizeof(own.id))
+            || bpfCall(BPF_PROG_QUERY, query) || query.query.prog_cnt > 64) return false;
+    unsigned before = 64, after = 64;
+    for (unsigned n = 0; n < query.query.prog_cnt; ++n) {
+        if (ids[n] == prior.id) before = n;
+        if (ids[n] == own.id) after = n;
+    }
+    return before < after && after < 64;
+}
+inline bool quotaReady(uint32_t& index, bool create = false) {
+    uint32_t error = 0;
+    unique_fd map(object("map_roydquota_quota_budget"));
+    unique_fd drops(object("map_roydquota_quota_drops"));
+    if (!ready(index, error) || !map.ok() || !quotaMap(map.get()) || !drops.ok()
+            || !mapLayout(drops.get(), BPF_MAP_TYPE_ARRAY, sizeof(QuotaDrops))) return false;
+    uint32_t existing = 0;
+    union bpf_attr first = {};
+    first.map_fd = map.get();
+    first.next_key = reinterpret_cast<uintptr_t>(&existing);
+    if (bpfCall(BPF_MAP_GET_NEXT_KEY, first)) {
+        if (errno != ENOENT) return false;
+    } else if (existing != index) return false;
+    return quotaLink(index, true, create) && quotaLink(index, false, create);
+}
+inline bool initialiseQuota() {
+    if (!enabled()) return true;
+    uint32_t index = 0;
+    return quotaReady(index, true);  // Preserve any existing generation and remainder.
+}
+inline int readQuota(QuotaValue& value, QuotaDrops& drops, bool& present) {
+    std::lock_guard guard(quotaMutex());
+    uint32_t index = 0;
+    if (!quotaReady(index)) return -EIO;
+    unique_fd map(object("map_roydquota_quota_budget"));
+    unique_fd counts(object("map_roydquota_quota_drops"));
+    if (!map.ok() || !counts.ok() || !lookup(counts.get(), 0, drops)) return -EIO;
+    present = lookup(map.get(), index, value);
+    if (!present) return errno == ENOENT ? 0 : -EIO;
+    if (!value.generation || !value.limit || value.limit > INT64_MAX
+            || value.remaining > value.limit) return -EIO;
+    return 0;
+}
+inline int setQuota(int64_t bytes) {
+    if (bytes <= 0) return -ERANGE;
+    std::lock_guard guard(quotaMutex());
+    uint32_t index = 0;
+    if (!quotaReady(index)) return -EIO;
+    unique_fd map(object("map_roydquota_quota_budget"));
+    if (!map.ok()) return -EIO;
+    QuotaValue old = {};
+    if (lookup(map.get(), index, old)) {
+        if (!old.generation || !old.limit || old.limit > INT64_MAX
+                || old.remaining > old.limit) return -EIO;
+    } else if (errno != ENOENT) return -EIO;
+    struct timespec now = {};
+    if (clock_gettime(CLOCK_MONOTONIC, &now)) return -errno;
+    const uint64_t tick = uint64_t(now.tv_sec) * 1000000000 + now.tv_nsec;
+    if (old.generation == UINT64_MAX) return -EOVERFLOW;
+    QuotaValue fresh = {uint64_t(bytes), uint64_t(bytes),
+                       tick > old.generation ? tick : old.generation + 1};
+    if (update(map.get(), index, fresh, BPF_ANY)) return -errno;
+    return 0;
+}
+inline int removeQuota() {
+    std::lock_guard guard(quotaMutex());
+    uint32_t index = 0;
+    if (!quotaReady(index)) return -EIO;
+    unique_fd map(object("map_roydquota_quota_budget"));
+    if (!map.ok()) return -EIO;
+    union bpf_attr attr = {};
+    attr.map_fd = map.get();
+    attr.key = reinterpret_cast<uintptr_t>(&index);
+    if (bpfCall(BPF_MAP_DELETE_ELEM, attr)) return errno == ENOENT ? -ENODEV : -errno;
+    return 0;
+}
+}  // namespace android::net::royd

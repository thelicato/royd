diff --git a/packages/modules/Connectivity/bpf/progs/royd_quota.h b/packages/modules/Connectivity/bpf/progs/royd_quota.h
--- /dev/null
+++ b/packages/modules/Connectivity/bpf/progs/royd_quota.h
@@ -0,0 +1,28 @@
+/* Copyright 2026 The royd Authors. SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+// Immutable metadata and one aligned shared budget. Replace the entire hash
+// element on update; never copy new fields over an element used by a packet.
+struct RoydQuota { uint64_t remaining, limit, generation; };
+struct RoydQuotaDrops { uint64_t invalid, contention; };
+
+// 1 admits the complete skb, 0 exhausts it, -1 rejects invalid state, and -2
+// refuses this skb after bounded contention. No path grants a separate allowance.
+static __always_inline inline int royd_quota_take(struct RoydQuota* quota, uint64_t bytes) {
+    // CAS(0, 0) is an atomic snapshot, including on the pinned BPF compiler.
+    uint64_t left = __sync_val_compare_and_swap(&quota->remaining, 0, 0);
+    if (!bytes || bytes > INT64_MAX || !quota->limit || quota->limit > INT64_MAX
+            || !quota->generation) return -1;
+#ifdef __clang__
+#pragma clang loop unroll(disable)
+#endif
+    for (unsigned attempt = 0; attempt < 64; ++attempt) {
+        if (left > quota->limit) return -1;
+        if (!left) return 0;
+        uint64_t next = bytes <= left ? left - bytes : 0;
+        uint64_t observed = __sync_val_compare_and_swap(&quota->remaining, left, next);
+        if (observed == left) return bytes <= left;
+        left = observed;
+    }
+    return -2;
+}
diff --git a/packages/modules/Connectivity/bpf/progs/roydquota.c b/packages/modules/Connectivity/bpf/progs/roydquota.c
--- /dev/null
+++ b/packages/modules/Connectivity/bpf/progs/roydquota.c
@@ -0,0 +1,42 @@
+/* Copyright 2026 The royd Authors. SPDX-License-Identifier: Apache-2.0 */
+#define BPFLOADER_MIN_VER BPFLOADER_MAINLINE_T_VERSION
+#include "bpf_net_helpers.h"
+#include "royd_quota.h"
+#include "royd_iface_account.h"
+
+// Non-per-CPU, non-LRU hash replacement publishes a new immutable generation.
+// NO_PREALLOC gives old packet references their own RCU-retired allocation.
+const struct bpf_map_def SECTION("maps") quota_budget = {
+    .type = BPF_MAP_TYPE_HASH, .key_size = sizeof(uint32_t),
+    .value_size = sizeof(struct RoydQuota), .max_entries = 1,
+    .map_flags = BPF_F_NO_PREALLOC, .uid = AID_ROOT, .gid = AID_NET_BW_ACCT,
+    .mode = 0660, .bpfloader_min_ver = BPFLOADER_MIN_VER,
+    .bpfloader_max_ver = BPFLOADER_MAX_VER, .max_kver = 0xffffffffU,
+};
+DEFINE_BPF_MAP_UGM(quota_drops, ARRAY, uint32_t, struct RoydQuotaDrops, 1,
+                   AID_ROOT, AID_NET_BW_ACCT, 0660)
+
+static __always_inline inline int royd_quota_packet(struct __sk_buff* skb) {
+    uint32_t key = skb->ifindex;
+    struct RoydQuota* quota = bpf_map_lookup_elem_unsafe(&quota_budget, &key);
+    if (!quota) return TC_ACT_UNSPEC;  // No registered quota, not measured zero use.
+    uint64_t bytes = 0, packets = 0;
+    int parsed = royd_ip_counters(skb, &bytes, &packets);
+    if (!parsed) return TC_ACT_UNSPEC;  // ARP and other L2 traffic have no IP budget.
+    int result = parsed < 0 ? -1 : royd_quota_take(quota, bytes);
+    if (result < 0) {
+        uint32_t zero = 0;
+        struct RoydQuotaDrops* drops = bpf_quota_drops_lookup_elem(&zero);
+        if (drops) {
+            if (result == -2) __sync_fetch_and_add(&drops->contention, 1);
+            else __sync_fetch_and_add(&drops->invalid, 1);
+        }
+    }
+    return result == 1 ? TC_ACT_UNSPEC : TC_ACT_SHOT;
+}
+
+DEFINE_OPTIONAL_BPF_PROG("schedcls/ingress", AID_ROOT, AID_ROOT, quota_ingress)
+(struct __sk_buff* skb) { return royd_quota_packet(skb); }
+DEFINE_OPTIONAL_BPF_PROG("schedcls/egress", AID_ROOT, AID_ROOT, quota_egress)
+(struct __sk_buff* skb) { return royd_quota_packet(skb); }
+LICENSE("Apache 2.0");

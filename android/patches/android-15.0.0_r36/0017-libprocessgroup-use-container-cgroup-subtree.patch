+static bool IsRoydContainerCgroup(const CgroupController* controller) {
+    const char* royd_container = getenv("ROYD_CONTAINER");
+    return royd_container != nullptr && strcmp(royd_container, "1") == 0 &&
+            access("/sys/fs/selinux/enforce", F_OK) != 0 &&
+            strcmp(controller->name(), CGROUPV2_HIERARCHY_NAME) == 0 &&
+            strcmp(controller->path(), "/sys/fs/cgroup/royd") == 0 &&
+            access("/sys/fs/cgroup/cgroup.controllers", F_OK) == 0;
+}
+
+static bool ChangePathModeAndOwner(const std::string& path, mode_t mode,
+                                   const std::string& uid, const std::string& gid) {
+    passwd* uid_pwd = getpwnam(uid.c_str());
+    if (!uid_pwd) {
+        PLOG(ERROR) << "Unable to decode UID for '" << uid << "'";
+        return false;
+    }
+    group* gid_pwd = getgrnam(gid.c_str());
+    if (!gid_pwd) {
+        PLOG(ERROR) << "Unable to decode GID for '" << gid << "'";
+        return false;
+    }
+    if (chown(path.c_str(), uid_pwd->pw_uid, gid_pwd->gr_gid) < 0 ||
+        chmod(path.c_str(), mode) < 0) {
+        PLOG(ERROR) << "Change of ownership or mode failed for " << path;
+        return false;
+    }
+    return true;
+}

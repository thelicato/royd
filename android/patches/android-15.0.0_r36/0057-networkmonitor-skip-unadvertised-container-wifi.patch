+    private static boolean shouldSkipRoydWifi(Context context) {
+        if (!"1".equals(System.getenv("ROYD_CONTAINER"))
+                || context.getPackageManager().hasSystemFeature(PackageManager.FEATURE_WIFI)) {
+            return false;
+        }
+        try {
+            android.system.Os.stat("/sys/fs/selinux/enforce");
+            return false;
+        } catch (android.system.ErrnoException error) {
+            return error.errno == android.system.OsConstants.ENOENT;
+        }
+    }

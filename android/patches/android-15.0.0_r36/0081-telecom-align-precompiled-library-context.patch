+func TestUsesLibraryExclusionsMatchDexpreopt(t *testing.T) {
+	for _, test := range []struct {
+		name     string
+		property string
+		expected []string
+	}{
+		{"unchanged", "", []string{"foo", "bar"}},
+		{"excluded", `exclude_uses_libs: ["foo"],`, []string{"bar"}},
+		{"unknown", `exclude_uses_libs: ["missing"],`, []string{"foo", "bar"}},
+		{"all", `exclude_uses_libs: ["foo", "bar"],`, []string{}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			bp := `
+				java_sdk_library {
+					name: "foo",
+					srcs: ["a.java"],
+					api_packages: ["foo"],
+					sdk_version: "current",
+				}
+				java_sdk_library {
+					name: "bar",
+					srcs: ["a.java"],
+					api_packages: ["bar"],
+					sdk_version: "current",
+				}
+				java_library {
+					name: "helper",
+					srcs: ["a.java"],
+					libs: ["foo.impl", "bar.impl"],
+					sdk_version: "current",
+				}
+				android_app {
+					name: "app",
+					srcs: ["a.java"],
+					static_libs: ["helper"],
+					sdk_version: "current",
+					enforce_uses_libs: true,
+					` + test.property + `
+				}
+			`
+			result := android.GroupFixturePreparers(
+				prepareForJavaTest,
+				PrepareForTestWithJavaSdkLibraryFiles,
+				FixtureWithLastReleaseApis("foo", "bar"),
+			).RunTestWithBp(t, bp)
+			app := result.ModuleForTests("app", "android_common")
+			module := app.Module().(*AndroidApp)
+			required, optional := module.dexpreopter.classLoaderContexts.UsesLibs()
+			android.AssertDeepEquals(t, "dexpreopt required libraries", test.expected, required)
+			if len(optional) != 0 {
+				t.Fatalf("unexpected optional libraries: %v", optional)
+			}
+			manifest := app.Output("manifest_fixer/AndroidManifest.xml").Args["args"]
+			verify := app.Rule("verify_uses_libraries").RuleParams.Command
+			for _, name := range []string{"foo", "bar"} {
+				want := android.InList(name, test.expected)
+				for _, args := range []string{manifest, verify} {
+					if strings.Contains(args, "--uses-library "+name) != want {
+						t.Fatalf("manifest/verification context differs for %s: %s", name, args)
+					}
+				}
+			}
+			if !module.dexpreopter.enforceUsesLibs {
+				t.Fatal("uses-library verification was disabled")
+			}
+			app.Rule("dexpreopt")
+		})
+	}
 }


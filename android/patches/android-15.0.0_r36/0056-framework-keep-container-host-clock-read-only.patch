+++ b/frameworks/base/apex/jobscheduler/service/java/com/android/server/alarm/AlarmManagerService.java
@@ -2089,12 +2089,16 @@
     boolean setTimeImpl(
             @CurrentTimeMillisLong long newSystemClockTimeMillis, @TimeConfidence int confidence,
             @NonNull String logMsg) {
+        if (SystemClockTime.isRoydHostClockReadOnly()) {
+            SystemClockTime.addDebugLogEntry("ROYD: refused host clock update: " + logMsg);
+            return false;
+        }
         synchronized (mLock) {
             mInjector.setCurrentTimeMillis(newSystemClockTimeMillis, confidence, logMsg);

             // The native implementation of setKernelTime can return -1 even when the kernel
             // time was set correctly, so assume setting kernel time was successful and always
             // return true.
             return true;
         }
     }

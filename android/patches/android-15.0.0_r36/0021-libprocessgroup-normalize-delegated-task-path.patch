--- a/system/core/libprocessgroup/cgroup_map.cpp
+++ b/system/core/libprocessgroup/cgroup_map.cpp
@@ -17,7 +17,9 @@
 //#define LOG_NDEBUG 0
 #define LOG_TAG "libprocessgroup"
 
 #include <errno.h>

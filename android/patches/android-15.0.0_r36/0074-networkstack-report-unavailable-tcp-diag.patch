+package com.android.networkstack.netlink;
+
+import android.system.ErrnoException;
+import android.system.Os;
+import android.system.OsConstants;
+
+import com.android.net.module.util.netlink.StructNlMsgHdr;
+
+import java.nio.ByteBuffer;
+
+/** Scoped availability state, owned by the TcpSocketTracker state-machine thread. */
+final class RoydTcpDiag {
+    static final class Unavailable extends RuntimeException {}
+
+    private final boolean mEnabled = detectContainer();
+    private boolean mUnavailable;
+    private boolean mReported;
+    private int mDoneFamilies;
+    private boolean mRecoveryBroken;
+
+    private static boolean detectContainer() {
+        if (!"1".equals(System.getenv("ROYD_CONTAINER"))) return false;
+        try {
+            Os.stat("/sys/fs/selinux/enforce");
+            return false;
+        } catch (ErrnoException error) {
+            return error.errno == OsConstants.ENOENT;
+        }
+    }
+
+    // Called only for NLMSG_ERROR, with the cursor immediately after its outer header.
+    // Recognise the complete uncapped echo of this exact outstanding TCP dump request.
+    // ACKs, other errors, unrelated requests and malformed/capped replies stay stock.
+    void checkUnavailable(ByteBuffer bytes, int length, int sequence, int flags, byte[] request) {
+        if (!mEnabled || flags != 0 || request == null
+                || request.length < StructNlMsgHdr.STRUCT_SIZE) {
+            return;
+        }
+        final long expected = (long) StructNlMsgHdr.STRUCT_SIZE + Integer.BYTES + request.length;
+        if (length != expected || bytes.remaining() < length - StructNlMsgHdr.STRUCT_SIZE) {
+            return;
+        }
+        final ByteBuffer original = ByteBuffer.wrap(request).order(bytes.order());
+        if (sequence != original.getInt(8)) return;
+        final ByteBuffer payload = bytes.duplicate().order(bytes.order());
+        if (payload.getInt() != -OsConstants.ENOENT) return;
+        for (byte value : request) {
+            if (payload.get() != value) return;
+        }
+        throw new Unavailable();
+    }
+
+    boolean markUnavailable() {
+        mUnavailable = true;
+        if (mReported) return false;
+        mReported = true;
+        return true;
+    }
+
+    void startPoll() {
+        mDoneFamilies = 0;
+        mRecoveryBroken = false;
+    }
+
+    void recordHeader(ByteBuffer bytes, int length, int sequence, int flags, byte[] request) {
+        if (!mEnabled) return;
+        if (request == null || request.length < StructNlMsgHdr.STRUCT_SIZE
+                || length < StructNlMsgHdr.STRUCT_SIZE
+                || length - StructNlMsgHdr.STRUCT_SIZE > bytes.remaining()
+                || (flags & 0x10) != 0  // NLM_F_DUMP_INTR applies to every dump message.
+                || sequence != ByteBuffer.wrap(request).order(bytes.order()).getInt(8)) {
+            mRecoveryBroken = true;
+        }
+    }
+
+    // Recovery requires both complete dumps, not another parser error or partial family.
+    void recordDone(ByteBuffer bytes, int length, int sequence, int flags,
+            int family, byte[] request) {
+        if (!mEnabled || request == null || request.length < StructNlMsgHdr.STRUCT_SIZE
+                || (flags & ~0x2) != 0  // Only plain or NLM_F_MULTI completion.
+                || sequence != ByteBuffer.wrap(request).order(bytes.order()).getInt(8)) {
+            return;
+        }
+        if (length != StructNlMsgHdr.STRUCT_SIZE + Integer.BYTES
+                || bytes.remaining() < Integer.BYTES
+                || bytes.getInt(bytes.position()) != 0) return;
+        if (family == OsConstants.AF_INET) mDoneFamilies |= 1;
+        if (family == OsConstants.AF_INET6) mDoneFamilies |= 2;
+    }
+
+    boolean isIncompleteRecovery() {
+        return mUnavailable && (mDoneFamilies != 3 || mRecoveryBroken);
+    }
+
+    void markAvailable() {
+        if (mDoneFamilies == 3 && !mRecoveryBroken) mUnavailable = false;
+    }
+
+    boolean isUnavailable() {
+        return mUnavailable;
+    }
+}

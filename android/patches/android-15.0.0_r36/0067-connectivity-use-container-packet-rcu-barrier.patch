diff --git a/packages/modules/Connectivity/staticlibs/native/bpfmapjni/RoydNetworkStatsRcu.h b/packages/modules/Connectivity/staticlibs/native/bpfmapjni/RoydNetworkStatsRcu.h
new file mode 100644

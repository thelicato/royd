+++ b/packages/modules/Connectivity/staticlibs/native/bpfmapjni/RoydNetworkStatsRcu.h
@@ -0,0 +1,46 @@
+/* Copyright 2026 The royd Authors. SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include <atomic>
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <linux/pfkeyv2.h>
+#include <log/log.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace royd {
+inline std::atomic_bool packetRcuReported{false};
+
+inline bool containerWithoutSelinux() {
+    const char* value = getenv("ROYD_CONTAINER");
+    if (!value || strcmp(value, "1")) return false;
+    struct stat info;
+    return stat("/sys/fs/selinux/enforce", &info) != 0 && errno == ENOENT;
+}
+
+// Preserve stock PF_KEY handling. Linux packet_release() also waits for
+// synchronize_net(), even for a protocol-zero socket with no receive hook.
+inline int synchronizeNetworkStatsRcu(const char*& operation) {
+    operation = "nativeSynchronizeKernelRCU:socket";
+    int fd = socket(AF_KEY, SOCK_RAW | SOCK_CLOEXEC, PF_KEY_V2);
+    if (fd >= 0) {
+        operation = "nativeSynchronizeKernelRCU:close";
+        return close(fd) == 0 ? 0 : -errno;
+    }
+    const int stockError = errno;
+    if (stockError != EAFNOSUPPORT || !containerWithoutSelinux()) return -stockError;
+    operation = "nativeSynchronizeKernelRCU:packet_socket";
+    // Protocol zero never registers a receive hook. Do not bind, send or receive.
+    fd = socket(AF_PACKET, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+    if (fd < 0) return -errno;
+    operation = "nativeSynchronizeKernelRCU:packet_close";
+    if (close(fd)) return -errno;
+    if (!packetRcuReported.exchange(true)) {
+        ALOGI("ROYD: using packet-socket RCU grace periods for network statistics");
+    }
+    return 0;
+}
+}  // namespace royd

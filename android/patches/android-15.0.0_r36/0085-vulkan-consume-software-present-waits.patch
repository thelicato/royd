+// SwiftShader's Android release hook drains its queue but ignores its input
+// semaphores. Submit the waits once at the presentation-batch boundary so its
+// existing queue drain honours them, including a batch with multiple swapchains.
+static bool UseRoydSoftwarePresentWait(VkQueue queue) {
+#if defined(__x86_64__)
+    const char* container = getenv("ROYD_CONTAINER");
+    if (!container || strcmp(container, "1") != 0) return false;
+    struct stat info;
+    if (stat("/sys/fs/selinux/enforce", &info) != -1 || errno != ENOENT) return false;
+
+    VkPhysicalDevice physical_device = GetData(queue).driver_physical_device;
+    const auto& driver = GetData(physical_device).driver;
+    if (!driver.GetPhysicalDeviceProperties2) return false;
+    VkPhysicalDeviceDriverProperties driver_properties = {};
+    driver_properties.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES;
+    VkPhysicalDeviceProperties2 properties = {};
+    properties.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2;
+    properties.pNext = &driver_properties;
+    driver.GetPhysicalDeviceProperties2(physical_device, &properties);
+    return driver_properties.driverID == VK_DRIVER_ID_GOOGLE_SWIFTSHADER;
+#else
+    (void)queue;
+    return false;
+#endif
+}

+        // commonly lack this host sysfs interface, so do not invoke the reader merely to produce
+        // warnings and a fatal diagnostic before terminating the service anyway.
+        if (shouldSkipRoydCpuMonitor()) {
+            Slogf.i(TAG, "ROYD: CPU frequency policies unavailable; CPU monitor disabled");
+            return;
+        }

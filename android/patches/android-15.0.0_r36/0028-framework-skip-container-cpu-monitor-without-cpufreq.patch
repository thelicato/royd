+    private static boolean shouldSkipRoydCpuMonitor() {
+        if (!"1".equals(System.getenv("ROYD_CONTAINER")) || SELinux.isSELinuxEnabled()) {
+            return false;
+        }
+        File[] policyDirs = new File("/sys/devices/system/cpu/cpufreq").listFiles(
+                file -> file.isDirectory() && file.getName().startsWith("policy"));
+        return policyDirs == null || policyDirs.length == 0;
+    }
+

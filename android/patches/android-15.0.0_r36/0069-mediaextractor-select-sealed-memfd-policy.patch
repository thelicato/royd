diff --git a/frameworks/av/services/mediaextractor/RoydMediaExtractorPolicy.h b/frameworks/av/services/mediaextractor/RoydMediaExtractorPolicy.h
--- /dev/null
+++ b/frameworks/av/services/mediaextractor/RoydMediaExtractorPolicy.h
@@ -0,0 +1,26 @@
+/* Copyright 2026 The royd Authors. SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <android-base/properties.h>
+
+namespace royd {
+inline const char* mediaExtractorSeccompPolicy(const char* stockPolicy) {
+#if defined(__x86_64__)
+    const char* container = getenv("ROYD_CONTAINER");
+    if (!container || strcmp(container, "1")) return stockPolicy;
+    struct stat info;
+    if (stat("/sys/fs/selinux/enforce", &info) == 0 || errno != ENOENT) {
+        return stockPolicy;
+    }
+    if (android::base::GetBoolProperty("ro.treble.enabled", false)
+            && android::base::GetBoolProperty("sys.use_memfd", false)) {
+        return "/vendor/etc/seccomp_policy/royd-mediaextractor-x86_64.policy";
+    }
+#endif
+    return stockPolicy;
+}
+}  // namespace royd

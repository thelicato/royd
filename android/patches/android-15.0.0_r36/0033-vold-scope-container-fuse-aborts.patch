+static bool IsRoydContainerWithoutSelinux() {
+    const char* roydContainer = getenv("ROYD_CONTAINER");
+    return roydContainer != nullptr && roydContainer[0] == '1' && roydContainer[1] == '\0' &&
+            is_selinux_enabled() <= 0;
+}
+
+static std::unordered_set<std::string> GetMountedFuseConnectionIds() {
+    std::string mountInfo;
+    std::unordered_set<std::string> connectionIds;
+    if (!ReadFileToString("/proc/self/mountinfo", &mountInfo)) {
+        PLOG(WARNING) << "Failed to read the current mount namespace for FUSE connections";
+        return connectionIds;
+    }
+
+    for (const auto& line : android::base::Split(mountInfo, "\n")) {
+        const auto fields = android::base::Split(line, " ");
+        const auto separator = std::find(fields.begin(), fields.end(), "-");
+        if (fields.size() < 3 || separator == fields.end() || separator + 1 == fields.end()) {
+            continue;
+        }
+        const std::string& fsType = *(separator + 1);
+        if (fsType != "fuse" && !StartsWith(fsType, "fuse.")) {
+            continue;
+        }
+        const std::string& device = fields[2];
+        const size_t colon = device.find(':');
+        if (colon != std::string::npos && colon + 1 < device.size()) {
+            connectionIds.insert(device.substr(colon + 1));
+        }
+    }
+    return connectionIds;
+}

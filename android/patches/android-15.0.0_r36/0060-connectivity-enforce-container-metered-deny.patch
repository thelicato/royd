+        if (sRoydMeteredIfaceMap == null) return;
+        try {
+            pw.println("sRoydMeteredIfaceMap: "
+                    + sRoydMeteredIfaceMap.getValue(ROYD_METERED_KEY).val);
+        } catch (ErrnoException error) {
+            pw.println("Failed to read OCI metered deny interface: " + error);
+        }
+    }

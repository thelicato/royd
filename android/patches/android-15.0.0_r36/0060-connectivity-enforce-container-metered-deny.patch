+static __always_inline inline bool royd_metered_uid_blocked(uint32_t ifindex, uint32_t uid) {
+    uint32_t key = 0;
+    uint32_t* metered = bpf_royd_metered_iface_map_lookup_elem(&key);
+    if (!metered || !*metered || ifindex == 1) return false;
+    if (*metered != UINT32_MAX && *metered != ifindex) return false;
+
+    UidOwnerValue* entry = bpf_uid_owner_map_lookup_elem(&uid);
+    // Match the stock penalty-before-happy-box ordering. Foreground/exemption
+    // decisions remain owned by NetworkPolicyManager's existing UID-rule updates.
+    return entry && (entry->rule & (PENALTY_BOX_USER_MATCH | PENALTY_BOX_ADMIN_MATCH));
+}
+
 static __always_inline inline int bpf_owner_match(struct __sk_buff* skb, uint32_t uid,
                                                   const struct egress_bool egress,
                                                   const struct kver_uint kver) {
     if (is_system_uid(uid)) return PASS;
+
+    // Metered deny must precede the generic protocol exceptions, just as the
+    // independent legacy penalty-box chain does. System UIDs remain exempt.
+    if (royd_metered_uid_blocked(skb->ifindex, uid)) return DROP;

     if (skip_owner_match(skb, egress, kver)) return PASS;


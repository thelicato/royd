+    public void setRoydMeteredInterface(int ifindex) {
+        if (sRoydMeteredIfaceMap == null || ifindex < 0 || ifindex == 1) {
+            throw new IllegalStateException("Invalid OCI metered deny interface: " + ifindex);
+        }
+        try {
+            sRoydMeteredIfaceMap.updateEntry(ROYD_METERED_KEY,
+                    new U32(ifindex == 0 ? ROYD_METERED_UNKNOWN : ifindex));
+        } catch (ErrnoException error) {
+            throw new IllegalStateException("Cannot update OCI metered deny interface", error);
+        }
+    }
+

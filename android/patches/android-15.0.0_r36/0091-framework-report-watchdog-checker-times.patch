+    private static void logRoydPreWatchdogCheckerTimes(List<HandlerChecker> checkers) {
+        if (!sRoydLocalDiagnostics) {
+            return;
+        }
+        // The caller holds mLock at the existing pre-watchdog event. Read each
+        // checker's own uptime clock once without changing its pending check.
+        for (HandlerChecker checker : checkers) {
+            final long sampledUptimeMillis = checker.mClock.millis();
+            Slog.i(TAG, "ROYD: pre-watchdog checker timing: name=" + checker.getName()
+                    + " start_uptime_ms=" + checker.mStartTimeMillis
+                    + " sampled_uptime_ms=" + sampledUptimeMillis
+                    + " elapsed_ms=" + (sampledUptimeMillis - checker.mStartTimeMillis)
+                    + " wait_max_ms=" + checker.mWaitMaxMillis);
+        }
+    }
